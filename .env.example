# Server-only admin authentication
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Server-only Pinecone access
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Server-only OpenAI access. Add this as a Sensitive variable in Vercel.
OPENAI_API_KEY=

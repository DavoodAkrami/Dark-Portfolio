# Server-only admin authentication
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Server-only Pinecone access
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Vercel AI Gateway uses the automatically injected VERCEL_OIDC_TOKEN in deployments.
# For local development, run: vercel env pull .env.local --yes
AI_MODEL=openai/gpt-4o-mini

# Server-only Vercel analytics access
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
